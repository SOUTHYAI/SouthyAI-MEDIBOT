{
  "name": "southyai-medibot",
  "version": "1.3.0",
  "description": "SOUTHYAI MediBot - multi-role health information assistant with 3D anatomy atlas, photo reading, voice input and emergency call help",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.4.2",
    "@electric-sql/pglite": "^0.2.17"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}